# Sao chép thành .env. Không commit khóa thật.
# Khóa dùng ở backend; người dùng không cần và không được nhập trên giao diện.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DOCWEAVE_MODEL=openai/gpt-4o-mini

DOCWEAVE_DATA_DIR=.cache/docweave
DOCWEAVE_MAX_UPLOAD_MB=25
DOCWEAVE_MAX_PAGES=100
DOCWEAVE_JOB_TIMEOUT=1800
DOCWEAVE_RETENTION_HOURS=24

# Bắt buộc khi mở máy chủ ra mạng; dùng một chuỗi ngẫu nhiên dài.
DOCWEAVE_ACCESS_TOKEN=
# Thêm domain/IP thật khi triển khai (không dùng *).
DOCWEAVE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
